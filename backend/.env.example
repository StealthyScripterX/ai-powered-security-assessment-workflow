# Copy this file to .env and fill in real values. Never commit .env.
#
# Database. Default is a local SQLite file -- adequate for this Phase 1
# vertical slice (TASD-v1.0.md ASM-A02 volume) given no PostgreSQL 16
# instance is available in this environment. Point this at a real
# PostgreSQL DSN (postgresql+asyncpg://user:pass@host/db) to match the
# approved architecture (TASD-v1.0.md §9.3, ADR-003) once one is
# provisioned -- see architecture/TASD-v1.0.md §9.3 and the blocking note
# in IMPLEMENTATION-NOTES.md.
DATABASE_URL=sqlite+aiosqlite:///./poc_workflow.db

# JWT signing secret for the local auth provider (Phase 1 placeholder for
# the OIDC integration TASD-v1.0.md §8.3 specifies -- see
# IMPLEMENTATION-NOTES.md). Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider. AI_PROVIDER selects which one is actually used --
# "anthropic" (default) or "gemini". The questionnaire-generation and
# mapping-generation endpoints return an explicit 503 "AI provider not
# configured" refusal (consistent with TASD-v1.0.md section 14.7's
# engine-refusal pattern) if the SELECTED provider's key is left blank --
# never a silent fallback or an invented response. Both providers' keys
# may be set at once; only AI_PROVIDER decides which is used.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Evidence object storage. "local" (default, this build's dev/test
# default -- a local-filesystem stand-in) or "s3" for real S3-compatible
# storage (app/services/storage.py). QUARANTINE_DIR/EVIDENCE_DIR are
# only used by the "local" backend.
STORAGE_BACKEND=local
QUARANTINE_DIR=var/quarantine
EVIDENCE_DIR=var/evidence

# Only used when STORAGE_BACKEND=s3. Two SEPARATE buckets (never one
# bucket with two prefixes) so a bucket policy can enforce "nothing in
# quarantine is ever world/app-readable" as an infrastructure-level
# guarantee -- see architecture/TASD-v1.0.md section 9.5/15.4.
S3_QUARANTINE_BUCKET=
S3_EVIDENCE_BUCKET=
S3_REGION=us-east-1
# Leave blank for real AWS S3; set for a non-AWS S3-compatible service
# (e.g. MinIO: http://localhost:9000).
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

APP_ENV=development
