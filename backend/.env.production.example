# Production environment template. Copy to .env on the deploy target
# (or, preferably, inject these as real environment variables from your
# secret manager and skip the file entirely) -- see deploy/DEPLOYMENT.md.
# Every value below marked CHANGE_ME must be replaced; nothing here is
# a usable default, unlike .env.example's local-dev defaults.

APP_ENV=production

# poc_app_rw (DML-only role -- see deploy/postgresql_roles.sql). The
# app never connects as poc_migrator; that role is used only for
# `alembic upgrade head` at deploy time, separately from app startup.
DATABASE_URL=postgresql+asyncpg://poc_app_rw:CHANGE_ME@CHANGE_ME_HOST:5432/poc_workflow

JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

STORAGE_BACKEND=s3
S3_QUARANTINE_BUCKET=CHANGE_ME-poc-quarantine
S3_EVIDENCE_BUCKET=CHANGE_ME-poc-evidence
S3_REGION=CHANGE_ME
# Blank for real AWS S3. Prefer an attached IAM role over static keys
# below wherever your deploy target supports it (ECS task role, EKS
# IRSA, etc.) -- leave both keys blank in that case.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
